---
import "../styles/global.css";

interface Props {
  title: string;
  date?: string;
  list?: string[];
  isBulleted?: boolean;
  image?: string;
  buttonTitle?: string;
  buttonLink?: string;
}

const {
  title = null,
  image = null,
  list = [],
  date = null,
  isBulleted = false,
  buttonLink = null,
  buttonTitle = "Click me!",
} = Astro.props;

const isExternalLink = buttonLink?.startsWith("http");
---

<article class="neo-panel flex h-full flex-col overflow-hidden">
  {
    image && (
      <div class="flex w-full border-b-3 border-[#21191c] bg-[#c98c9b] p-2">
        <img
          src={`/${image}`}
          alt={`${title} project preview`}
          loading="lazy"
          class="h-44 w-full border-3 border-[#21191c] object-cover grayscale-20 md:h-52"
        />
      </div>
    )
  }

  <div class="flex h-full flex-col p-5 sm:p-6">
    {
      date && (
        <p class="mb-3 w-fit border-2 border-[#21191c] bg-[#e8bcc6] px-2 py-1 text-xs font-black tracking-[0.08em] uppercase">
          {date}
        </p>
      )
    }
    <h2
      class="text-2xl leading-[0.95] font-black tracking-[-0.04em] uppercase lg:text-3xl"
    >
      {title}
    </h2>

    <ul
      class:list={[
        "mt-5 space-y-3 text-sm leading-relaxed sm:text-base",
        isBulleted && "list-[square] pl-5",
      ]}
    >
      {list.map((item) => <li>{item}</li>)}
    </ul>

    {
      buttonLink && (
        <a
          class="neo-button mt-auto self-start pt-3 text-sm"
          href={buttonLink}
          target={isExternalLink ? "_blank" : undefined}
          rel={isExternalLink ? "noreferrer" : undefined}
        >
          {buttonTitle}{" "}
          <span aria-hidden="true" class="ml-2">
            ↗
          </span>
        </a>
      )
    }
  </div>
</article>
