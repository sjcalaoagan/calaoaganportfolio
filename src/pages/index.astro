---
import Layout from "../layouts/Base_Main.astro";
import Card from "../components/Card.astro";
import "../styles/global.css";

const achievements_g10 = [
  "Grade 10 - 1st Quarter with Honors",
  "Grade 10 - 2nd and 4th Quarter with High Honors",
  "Grade 10 - 1st to 4th Quarter Conduct Award",
];

const achievements_g11_g12 = [
  "Grade 11 - 1st - 3rd Quarter Classroom Top #1 with High Honors",
  "Grade 11 - Subject Proficiency in Emerging Trends and Technologies in Programming & Programming Languages 1",
  "Grade 11 - Subject Proficiency in Programming Languages 1",
  "Grade 11 - Best VFX Award in CIIT Senior Highschool Video Campaign",
  "Grade 12 - 1st - 3rd Quarter Classroom Top #1 with High Honors",
  "Grade 12 - Subject Proficiency in Introduction to IOT & Industry Readiness",
  "Grade 12 - CIIT Values Award in Passion - Programming",
];

const exp_gamedev = [
  "Developed a game titled 'Shiro’s Fantastical Website!' with a team in fulfillment of I3, Practical Research 2, and Entrepreneurship classes. This game utilized the Godot engine and GDScript language.",
  "Served as the lead programmer for Between Two Worlds, a 3D platformer game developed in collaboration with my classmates as a hobby project. This game was released on itch.io on December 19, 2024, and utilized the Godot Engine for development.",
  "Developed two visual novels named 'The Day That You left' and 'Passing Faces'. The games utilizes Ren'Py, a visual novel engine that uses Python. Programmed both games alone with the help of tutorials. Released on itch.io on August 12, 2023 and October 13,2024 respectively.",
];

const exp_webdev = [
  "Designed websties as part of class requirements in collaboration with a team. One project was a simple portfolio website, while the other was a website for our Attendance Monitoring System (A.M.S), where I contributed to both the front-end and back-end development.",
  "Designed and published a retro-themed page in Neocities that serves as my personal website.",
];
---

<Layout title="Calaoagan Portfolio">
  <!-- HERO -->
  <section
    class="neo-grid min-h-screen px-5 pt-28 pb-16 sm:px-8 lg:flex lg:items-center lg:pt-36"
  >
    <div
      class="mx-auto grid w-full max-w-7xl items-center gap-10 lg:grid-cols-[1.35fr_0.65fr]"
    >
      <div class="relative z-10">
        <p
          class="mb-5 inline-block border-3 border-[#21191c] bg-[#e8bcc6] px-3 py-2 text-sm font-black tracking-[0.12em] uppercase shadow-[4px_4px_0_#21191c]"
        >
          Portfolio / 2026
        </p>
        <h1
          class="max-w-5xl text-[clamp(3.7rem,9vw,8.5rem)] leading-[0.78] font-black tracking-[-0.075em] uppercase"
        >
          Sean<br />Jefferson<br /><span class="text-[#8f4f60]">Calaoagan</span>
        </h1>
        <div class="7 mt-8 flex flex-wrap items-center gap-4">
          <p
            class="max-w-xl border-l-6 border-[#c98c9b] pl-4 text-lg leading-tight font-bold sm:text-2xl"
          >
            Aspiring AI developer and Cloud Engineer
          </p>
          <a class="neo-button" href="/works">Explore my work →</a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-lg lg:mx-0">
        <div
          class="absolute -top-4 right-0 left-4 h-full border-3 border-[#21191c] bg-[#c98c9b]"
        >
        </div>
        <img
          src="/hero-img.png"
          alt="Sean Calaoagan sitting by a window"
          class="relative aspect-square w-full border-3 border-[#21191c] object-cover"
        />
        <span
          class="absolute -bottom-5 -left-3 -rotate-3 border-3 border-[#21191c] bg-[#21191c] px-4 py-2 text-sm font-black text-[#f8f0eb] uppercase sm:text-base"
        >
          Websites, Games, & Others
        </span>
      </div>
    </div>
  </section>

  <!-- CAREER SUMMARY -->
  <section
    class="border-y-3 border-[#21191c] bg-[#c98c9b] px-5 py-16 sm:px-8 lg:py-24"
    id="about"
  >
    <div
      class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-center"
    >
      <div>
        <p class="font-black tracking-[0.14em] uppercase">01 / About</p>
        <h2
          class="mt-3 text-5xl leading-[0.9] font-black tracking-[-0.055em] uppercase sm:text-7xl"
        >
          Learning by<br />building.
        </h2>
      </div>
      <article class="neo-panel p-6 sm:p-10">
        <p class="text-lg leading-relaxed font-bold sm:text-2xl">
          I build small, static websites using HTML, CSS, Tailwind, and Astro.
          Currently building a Linux desktop application using PyQt and Python.
          Published five games in itch.io utilizing Ren'Py and Godot. Aiming to
          delve into AI and Cloud Computing.
        </p>
      </article>
    </div>
  </section>

  <!-- EXPERIENCES -->
  <section class="neo-grid px-5 py-16 sm:px-8 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 border-b-3 border-[#21191c] pb-5">
        <p class="font-black tracking-[0.14em] text-[#8f4f60] uppercase">
          02 / Practice
        </p>
        <h2
          class="mt-2 text-5xl leading-none font-black tracking-[-0.055em] uppercase sm:text-7xl"
        >
          Experience
        </h2>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        <Card
          title="Game Developer"
          list={exp_gamedev}
          image="gamedev-img.png"
          date="October 2022 - May 2025"
          isBulleted={true}
        />
        <Card
          title="Web Developer"
          list={exp_webdev}
          image="webdev-img.png"
          date="January 2024 - Present"
          isBulleted={true}
        />
      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section
    class="border-t-3 border-[#21191c] bg-[#e8bcc6] px-5 py-16 sm:px-8 lg:py-24"
  >
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 border-b-3 border-[#21191c] pb-5">
        <p class="font-black tracking-[0.14em] uppercase">03 / Foundation</p>
        <h2
          class="mt-2 text-5xl leading-none font-black tracking-[-0.055em] uppercase sm:text-7xl"
        >
          Education
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-8 xl:grid-cols-3">
        <Card
          title="Manila Cathedral School"
          list={achievements_g10}
          image="mcs-img.jpg"
          date="2013-2023"
          isBulleted={true}
        />
        <Card
          title="CIIT Senior High School"
          list={achievements_g11_g12}
          image="cshs-img.jpg"
          date="2023-2025"
          isBulleted={true}
        />
        <Card
          title="CIIT College of Innovation and Integrated Technology"
          list={[
            "BSCS - Specialization in AI and Cloud Computing",
            "Interweave Scholar",
          ]}
          image="ccollege.png"
          date="2025-Present"
          isBulleted={true}
        />
      </div>
    </div>
  </section>
</Layout>
