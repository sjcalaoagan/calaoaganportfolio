---
import Nav from "../components/Nav.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title = "Works",
  description = "The works of Sean Jefferson M. Calaoagan, a.k.a. XianShizukana",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="neo-grid min-h-screen">
    <a
      class="neo-button fixed top-2 left-2 z-100 -translate-y-24 focus:translate-y-0"
      href="#main-content">Skip to content</a
    >
    <Nav />
    <main
      id="main-content"
      class="mx-auto max-w-7xl px-5 pt-32 pb-20 sm:px-8 lg:pt-40"
    >
      <div
        class="mb-12 flex flex-col items-start gap-4 border-b-3 border-[#21191c] pb-8 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="mb-3 font-black tracking-[0.14em] text-[#8f4f60] uppercase">
            Selected archive
          </p>
          <h1
            class="text-5xl leading-[0.85] font-black tracking-[-0.06em] uppercase sm:text-7xl lg:text-8xl"
          >
            {title}
          </h1>
        </div>
        <a class="neo-button" href="/works">← All works</a>
      </div>
      <section class="grid gap-8 xl:grid-cols-2">
        <slot />
      </section>
    </main>
  </body>
</html>
